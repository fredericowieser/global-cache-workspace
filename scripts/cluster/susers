#!/usr/bin/env python3
"""Show GPUs allocated to running Slurm jobs by user."""

import json
import re
import subprocess
from collections import defaultdict


jobs = json.loads(subprocess.check_output(["squeue", "--json"], text=True))["jobs"]
totals = defaultdict(int)
for job in jobs:
    if "RUNNING" not in job["job_state"]:
        continue
    gpus = None
    for resource in (job.get("tres_alloc_str") or "").split(","):
        if resource.startswith("gres/gpu="):
            gpus = int(resource.split("=", 1)[1])
            break
    if gpus is None:
        gpus = sum(
            int(match.group(1))
            for detail in job.get("gres_detail") or []
            for match in re.finditer(
                r"(?:^|,)gpu:(?:[^:(),]+:)?(\d+)(?=\(|,|$)", detail
            )
        )
    if gpus:
        totals[job["user_name"]] += gpus

print(f'{"USER":<20} {"GPUS":>5}')
for user, gpus in sorted(totals.items(), key=lambda item: (-item[1], item[0])):
    print(f"{user:<20} {gpus:>5}")
print(f'{"TOTAL":<20} {sum(totals.values()):>5}')
